<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="colorBackground">#121212</color>
    <color name="colorBtConnected">#00C853</color>
    <color name="colorBtDisconnected">#757575</color>
    <color name="colorError">#D32F2F</color>
    <color name="colorOnBackground">#EFEFEF</color>
    <color name="colorPrimary">#00C853</color>
    <color name="colorSecondary">#0091EA</color>
    <color name="colorSurface">#1E1E1E</color>
    <string name="action_connect">Conectar</string>
    <string name="action_disconnect">Desconectar</string>
    <string name="app_name">Rover Control</string>
    <string name="connect_title">Conectar ao Rover</string>
    <string name="nav_arm">Braço</string>
    <string name="nav_drive">Dirigir</string>
    <style name="ArmButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:backgroundTint">@color/colorSurface</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="DpadButton">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:backgroundTint">@color/colorSurface</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:layout_margin">2dp</item>
    </style>
    <style name="PresetButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:backgroundTint">@color/colorSurface</item>
        <item name="android:textColor">@color/colorSecondary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ServoLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/colorOnBackground</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
    <style name="ServoSeek">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:progressTint">@color/colorPrimary</item>
        <item name="android:thumbTint">@color/colorPrimary</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>
    <style name="Theme.RoverControl" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="colorError">@color/colorError</item>
    </style>
</resources>