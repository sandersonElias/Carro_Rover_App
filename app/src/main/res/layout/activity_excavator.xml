<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorSurface"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="Voltar"
            android:rotation="180" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Modo Escavadeira"
            android:textColor="@color/colorOnBackground"
            android:textSize="18sp"
            android:textStyle="bold" />

    </androidx.appcompat.widget.Toolbar>

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Left Side: Joystick 1 (Base + Ombro) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ControlCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Base + Ombro"
                    android:textColor="@color/colorOnBackground"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <com.rover.control.ui.drive.JoystickView
                    android:id="@+id/joystick_left"
                    android:layout_width="180dp"
                    android:layout_height="180dp" />

                <!-- Servo Angles Display -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_base_angle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Base: 90°"
                        android:textColor="@color/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:id="@+id/tv_ombro_angle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ombro: 90°"
                        android:textColor="@color/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Center: Gripper Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Garra"
                android:textColor="@color/colorOnBackground"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_gripper_open"
                style="@style/PrimaryButton"
                android:layout_width="100dp"
                android:text="Abrir"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_gripper_close"
                style="@style/DangerButton"
                android:layout_width="100dp"
                android:text="Fechar"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btn_home"
                style="@style/SecondaryButton"
                android:layout_width="100dp"
                android:text="Home" />

        </LinearLayout>

        <!-- Right Side: Joystick 2 (Cotovelo + Pulso) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ControlCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cotovelo + Pulso"
                    android:textColor="@color/colorOnBackground"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <com.rover.control.ui.drive.JoystickView
                    android:id="@+id/joystick_right"
                    android:layout_width="180dp"
                    android:layout_height="180dp" />

                <!-- Servo Angles Display -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_cotovelo_angle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cotovelo: 90°"
                        android:textColor="@color/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:id="@+id/tv_pulso_angle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pulso: 90°"
                        android:textColor="@color/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>
