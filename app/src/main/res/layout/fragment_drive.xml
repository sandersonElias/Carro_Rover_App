<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Main Content -->
    <LinearLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Left Side: Joystick -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Controle Analógico"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <com.rover.control.ui.drive.JoystickView
                android:id="@+id/joystick"
                android:layout_width="240dp"
                android:layout_height="240dp" />

            <!-- Direction Indicator -->
            <TextView
                android:id="@+id/tv_direction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parado"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- Right Side: D-Pad + Emergency Stop -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="D-Pad"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <!-- D-Pad Grid -->
            <GridLayout
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:columnCount="3"
                android:rowCount="3">

                <View android:layout_width="60dp" android:layout_height="60dp" />

                <Button
                    android:id="@+id/btn_up"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="▲"
                    style="@style/DpadButton" />

                <View android:layout_width="60dp" android:layout_height="60dp" />

                <Button
                    android:id="@+id/btn_left"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="◀"
                    style="@style/DpadButton" />

                <Button
                    android:id="@+id/btn_stop"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="■"
                    android:backgroundTint="@color/colorError"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:layout_margin="2dp" />

                <Button
                    android:id="@+id/btn_right"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="▶"
                    style="@style/DpadButton" />

                <View android:layout_width="60dp" android:layout_height="60dp" />

                <Button
                    android:id="@+id/btn_down"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="▼"
                    style="@style/DpadButton" />

                <View android:layout_width="60dp" android:layout_height="60dp" />

            </GridLayout>

            <!-- Emergency Stop Button -->
            <Button
                android:id="@+id/btn_emergency_stop"
                style="@style/EmergencyStopButton"
                android:text="⏹ PARAR" />

        </LinearLayout>

    </LinearLayout>

    <!-- Connection Overlay -->
    <FrameLayout
        android:id="@+id/overlay_connection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorOverlay"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_bt_disconnected"
                android:layout_marginBottom="16dp"
                android:alpha="0.7" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desconectado"
                android:textColor="@color/colorOnBackground"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conecte-se ao Rover para controlar"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btn_connect_overlay"
                style="@style/PrimaryButton"
                android:layout_width="200dp"
                android:text="Conectar" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
